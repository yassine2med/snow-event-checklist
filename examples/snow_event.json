    {"id": "vendor", "title": "Confirm contractor on call and arrival times", "owner": "Facility coordinator", "due_hours": -24, "depends_on": ["forecast"]},
    {"id": "pretreat", "title": "Pretreat walkways, ramps and entrances", "owner": "Grounds lead", "due_hours": -8, "depends_on": ["salt-stock", "equipment"]},
